# ==========================================
# SAMARTH Backend Environment Variables
# ==========================================

# Django Secret Key (Generate a secure 50+ character random string for production)
DJANGO_SECRET_KEY=your-production-secret-key-here-keep-it-secret

# Set to false for production
DJANGO_DEBUG=false

# Comma-separated allowed hosts (Render subdomains and localhost)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated origins allowed to make API requests (your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# CSRF Trusted origins (required for Django 4/5/6 POST/Admin requests over HTTPS)
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://*.vercel.app

# Database URL provided by Render PostgreSQL or external provider (e.g., Supabase, Neon)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Optional: Set to true if you want the build process to seed initial demo data automatically
AUTO_SEED_DATA=false
